ours = hours_worked - 40</b></span></div><div><span style="background-color: transparent;"><b>overtime_pay = overtime_hours * 30</b></span></div></div></div></div></foreignObject><text x="240" y="534" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><tspan x="240" y="534">regular_pay = 40 * 20</tspan><tspan x="240" y="548">overtime_hours =</tspan><tspan x="240" y="562">hours_worked - 40</tspan><tspan x="240" y="576">overtime_pay =</tspan><tspan x="240" y="590">overtime_hours * 30</tspan></text></switch></g></g></g><g data-cell-id="zrqVRfCaUzUyVHK_jnL0-37"><g transform="translate(0.5,0.5)"><path d="M 119.72 301.35 L 119.72 321.47 Q 119.72 331.47 119.72 341.47 L 119.72 354.98" fill="none" stroke="#000000" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/><path d="M 119.72 360.23 L 116.22 353.23 L 119.72 354.98 L 123.22 353.23 Z" fill="#000000" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g></g><g data-cell-id="zEk83mV7duLxu8Q1J8hX-30"><g><rect x="0.45" y="525.35" width="96.77" height="67" rx="7" ry="7" fill="#ffffff" stroke="#000000" stroke-width="2" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 95px; height: 1px; padding-top: 559px; margin-left: 1px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><div><span style="color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));">regular_pay = hours_worked * 20</span></div><div><span style="color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));">overtime_pay = 0</span></div></div></div></div></foreignObject><text x="49" y="541" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><tspan x="49" y="541">regular_pay =</tspan><tspan x="49" y="555">hours_worked *</tspan><tspan x="49" y="569">20</tspan><tspan x="49" y="583">overtime_pay = 0</tspan></text></switch></g></g></g><g data-cell-id="YwHQIP9oljSu_-N6PiA6-1"><g><rect x="69.72" y="611.35" width="100" height="67" rx="7" ry="7" fill="#ffffff" stroke="#000000" stroke-width="2" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 98px; height: 1px; padding-top: 645px; margin-left: 71px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><div><span style="color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));"><br /></span></div><div><span style="color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));">weekly_pay = (hours_worked * regular_rate) + overtime_pay</span></div><div><br /></div></div></div></div></foreignObject><text x="120" y="613" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><tspan x="120" y="613"></tspan><tspan x="120" y="627">weekly_pay =</tspan><tspan x="120" y="641">(hours_worked *</tspan><tspan x="120" y="655">regular_rate) +</tspan><tspan x="120" y="669">overtime_pay</tspan><tspan x="120" y="683"></tspan></text></switch></g></g></g><g data-cell-id="YwHQIP9oljSu_-N6PiA6-81"><g transform="translate(0.5,0.5)"><path d="M 178.24 464.18 Q 236.8 464.17 236.89 509.56" fill="none" stroke="#000000" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/><path d="M 236.9 514.81 L 233.38 507.81 L 236.89 509.56 L 240.38 507.8 Z" fill="#000000" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g data-cell-id="YwHQIP9oljSu_-N6PiA6-90"><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 492px; margin-left: 231px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; background-color: #ffffff; "><div style="display: inline-block; font-size: 13px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; background-color: var(--ge-adaptive-bg, #ffffff); white-space: nowrap; ">Yes</div></div></div></foreignObject><text x="231" y="496" fill="#000000" font-family="Helvetica" font-size="13px" text-anchor="middle" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));">Yes</text></switch></g></g></g></g><g data-cell-id="YwHQIP9oljSu_-N6PiA6-87"><g transform="translate(0.5,0.5